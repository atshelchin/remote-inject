    // ==================== Custom Transfer ====================

    // Test: custom transfer
    window.testCustomTransfer = async function() {
      try {
        const account = getCurrentAccount()
        const toAddress = document.getElementById('transferTo').value.trim()
        const amountStr = document.getElementById('transferAmount').value.trim()

        if (!toAddress || !toAddress.match(/^0x[a-fA-F0-9]{40}$/)) {
          logResult(LOCALE === 'zh' ? '请输入有效的接收地址' : 'Please enter a valid recipient address', 'error')
          return
        }

        if (!amountStr || isNaN(parseFloat(amountStr))) {
          logResult(LOCALE === 'zh' ? '请输入有效的金额' : 'Please enter a valid amount', 'error')
          return
        }

        const amountWei = BigInt(Math.floor(parseFloat(amountStr) * 1e18))
        const valueHex = '0x' + amountWei.toString(16)

        logResult(LOCALE === 'zh' ? `发送 ${amountStr} ETH 到 ${toAddress.slice(0,8)}...` : `Sending ${amountStr} ETH to ${toAddress.slice(0,8)}...`, 'info')

        const txHash = await provider.request({
          method: 'eth_sendTransaction',
          params: [{
            from: account,
            to: toAddress,
            value: valueHex,
          }],
        })
        logResult(LOCALE === 'zh' ? `交易哈希: ${txHash}` : `Transaction hash: ${txHash}`)
      } catch (error) {
